#define ZMK_POINTING_DEFAULT_SCRL_VAL 300

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mt {
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        mmt: mmt {
            compatible = "zmk,behavior-hold-tap";
            label = "Mouse Mod Tap";
            bindings = <&mkp>, <&mkp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        holdtolayer: holdtolayer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTOLAYER";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
        };
    };

    macros {
        test: test {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>, <&macro_press>, <&macro_press>;

            label = "TEST";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC         &kp N1          &kp N2              &kp N3       &kp N4       &kp N5         &kp N6                &kp N7     &kp N8         &kp N9            &kp N0             &kp DELETE
&kp TAB         &kp B           &kp Y               &mt RA(P) O  &mt RA(Y) U  &kp SQT        &kp SEMI              &kp L      &kp D          &kp W             &kp V              &kp Z
&kp LEFT_SHIFT  &kp C           &kp I               &kp E        &mt RA(Q) A  &kp COMMA      &kp PERIOD            &kp H      &kp T          &mt RA(S) S       &kp N              &kp RIGHT_SHIFT
&kp LCTRL       &kp G           &kp X               &kp J        &kp K        &kp MINUS      &kp EQUAL             &kp R      &kp M          &kp F             &kp P              &kp Q
&kp C_MUTE      &mt LGUI GRAVE  &mt LEFT_ALT LC(V)  &kp SLASH    &kp ENTER    &kp BACKSPACE  &holdtolayer 1 LG(S)  &kp SPACE  &kp BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                                                                             &none                 &kp RIGHT  &kp UP         &kp LEFT          &kp DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        Game+Config {
            bindings = <
&kp ESC     &kp N1    &kp N2  &kp N3  &kp N4     &kp N5     &none  &none            &none            &none                           &none            &none
&kp TAB     &kp Q     &kp W   &kp E   &kp R      &kp N6     &none  &none            &none            &none                           &none            &none
&kp LSHFT   &kp A     &kp S   &kp D   &kp F      &kp N7     &none  &none            &none            &none                           &none            &none
&kp LCTRL   &kp Z     &kp X   &kp C   &kp V      &kp N8     &none  &none            &none            &none                           &none            &none
&kp C_MUTE  &kp LALT  &kp N0  &kp N9  &kp SPACE  &kp ENTER  &to 0  &studio_unlock   &bt BT_PRV       &bt BT_CLR                      &bt BT_NXT
                                                            &none  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_BRD
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };
};
